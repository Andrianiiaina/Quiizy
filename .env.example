# ============================================================
# LMS — Variables d'environnement
# cp .env.example .env  et remplir les valeurs manquantes
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev_password

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://lms:lms_dev_password@postgres:5432/lms
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
MAX_UPLOAD_SIZE_MB=50
STORAGE_BACKEND=LOCAL
STORAGE_LOCAL_PATH=/app/storage

# --- Frontend ---
VITE_API_BASE_URL=/api/v1

# --- AI Provider (Phase 8 — ne pas renseigner pour le MVP) ---
# AI_PROVIDER_URL=
# AI_PROVIDER_KEY=
# AUDIO_TRANSCRIPTION_PROVIDER=
